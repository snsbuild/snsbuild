---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import "../styles/global.css";
import { safeJsonLdString } from "../seo";

const defaults = {
  title: "Saddle & Spur Construction",
  description:
    "Licensed general contractor for residential remodeling in Seattle",
};

const { canonical, openGraph, jsonLd, robots, chrome = "full" } = Astro.props;

// Pages spread the whole seo result (`<Layout {...seo} />`), which carries the
// real title and description on openGraph — fall back to it before the generic
// site defaults, or every page ships the same <title>.
const title = Astro.props.title ?? openGraph?.title ?? defaults.title;
const description =
  Astro.props.description ?? openGraph?.description ?? defaults.description;
const safe = jsonLd ? safeJsonLdString(jsonLd) : null;

// Landing pages drop the full nav so paid traffic has one obvious next step.
const isMinimal = chrome === "minimal";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    {/* Google Ads (gtag.js) */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18410415934"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "AW-18410415934");
    </script>

    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {canonical && <link rel="canonical" href={canonical} />}

    {/* Open Graph */}
    {
      openGraph && (
        <>
          <meta
            property="og:site_name"
            content="Saddle and Spur Construction"
          />
          <meta property="og:title" content={openGraph.title} />
          <meta property="og:description" content={openGraph.description} />
          <meta property="og:url" content={openGraph.url} />
          <meta property="og:type" content={openGraph.type ?? "website"} />
          {openGraph.image && (
            <meta property="og:image" content={openGraph.image} />
          )}

          {/* Twitter */}
          {/* <meta name="twitter:site" content="@yourhandle" /> */}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={openGraph.title} />
          <meta name="twitter:description" content={openGraph.description} />
          {openGraph.image && (
            <meta name="twitter:image" content={openGraph.image} />
          )}
        </>
      )
    }

    {safe && <script type="application/ld+json" set:html={safe} />}
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display+SC:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.5.2/animate.min.css"
    />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1"
      type="module"></script>
    <script
      is:inline
      src="https://kit.fontawesome.com/99f5fb79cb.js"
      crossorigin="anonymous"></script>
  </head>

  <body class="flex flex-col min-h-screen bg-white text-gray-900">
    {isMinimal ? <LandingNav /> : <Header />}
    <main class="grow">
      <slot />
    </main>
    {isMinimal ? <LandingFooter /> : <Footer />}
  </body>
</html>
