---
import Img from "../Img.astro";

// Tagline endings that rotate after "Let's". The first is rendered into the
// HTML so the hero is complete before any script runs; keep them comma-free
// (ReplaceMe splits on commas).
const phrases = [
  "build something exceptional together",
  "design the kitchen you've imagined",
  "create a bathroom that feels like a retreat",
  "expand your home with confidence",
  "transform unused space into something purposeful",
  "build an ADU that works beautifully",
  "bring your renovation vision to life",
];
---

<div
  class="relative isolate overflow-hidden bg-white
       px-6
       py-16
       md:h-[calc(100vh-5rem)] md:px-8
       md:flex md:items-center"
>
  <Img
    widths={[640, 1024, 1440]}
    quality={50}
    src="/images/spiral-ceiling.jpg"
    alt=""
    class="absolute inset-0 -z-10 size-full object-cover opacity-10"
  />
  <div
    aria-hidden="true"
    class="hidden sm:absolute sm:-top-10 sm:right-1/2 sm:-z-10 sm:mr-10 sm:block sm:transform-gpu sm:blur-3xl"
  >
    <div
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      class="aspect-1097/845 w-274.25 bg-linear-to-tr from-[#ff4694] to-[#776fff] opacity-15"
    >
    </div>
  </div>
  <div
    aria-hidden="true"
    class="absolute -top-52 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl sm:-top-112 sm:ml-16 sm:translate-x-0"
  >
    <div
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      class="aspect-1097/845 w-274.25 bg-linear-to-tr from-[#ff4694] to-[#776fff] opacity-15"
    >
    </div>
  </div>
  <div class="mx-auto max-w-4xl text-center">
    {/* The H1 is the static head term, styled like the service-page eyebrow.
        The rotating tagline is a <p> so crawlers and screen readers get a
        stable heading. Its min-height reserves the tallest phrase at each
        breakpoint (measured in lines, including "Let's"), so rotating never
        moves the content below it. Re-measure if the phrases change. */}
    <h1 class="text-base/7 font-semibold text-indigo-600">
      Remodeling Services in Seattle
    </h1>
    <p
      class="mt-2 min-h-[5lh] text-5xl font-semibold tracking-tight text-gray-900 max-[359px]:min-h-[6lh] sm:text-7xl md:min-h-[4lh] lg:min-h-[3lh]"
    >
      Let's <br />
      <span id="replace-service-list" data-phrases={JSON.stringify(phrases)}
        >{phrases[0]}</span
      >
    </p>
    <p class="mt-8 text-lg font-medium text-pretty text-gray-700 sm:text-xl/8">
      Saddle & Spur Construction is a Seattle-based general contractor serving
      homeowners across King County with kitchen remodeling, bathroom
      renovations, ADU construction, home additions, and structural upgrades.
    </p>
  </div>
</div>

<script src="/js/replaceme.min.js" defer></script>

<script>
  declare global {
    interface Window {
      ReplaceMe: new (element: HTMLElement | null, options: any) => void;
    }
  }

  const options = {
    animation: "animated flipInX", // Animation class or classes
    speed: 3000, // Delay between each phrase in milliseconds
    separator: ",", // Phrases separator
    hoverStop: true, // Stop rotator on phrase hover
    clickChange: false, // Change phrase on click
    loopCount: "infinite", // Loop Count - 'infinite' or number
    autoRun: true, // Run rotator automatically
    onInit: false, // Function
    onChange: false, // Function
    onComplete: false, // Function
  };

  window.addEventListener("DOMContentLoaded", () => {
    const replaceEl = document.getElementById("replace-service-list");
    if (!replaceEl) return;
    const phrases: string[] = JSON.parse(replaceEl.dataset.phrases ?? "[]");
    if (phrases.length < 2) return;

    // The first phrase is already on screen. After one beat, hand ReplaceMe
    // the rest (ending with the first) so the rotation carries on from there.
    setTimeout(() => {
      replaceEl.textContent = [...phrases.slice(1), phrases[0]].join(
        options.separator,
      );
      new window.ReplaceMe(replaceEl, options);
    }, options.speed);
  });
</script>

<style is:global>
  /* The one animation ReplaceMe uses, lifted from animate.css 3.5.2 so the
     whole library doesn't load on every page. Global because ReplaceMe adds
     these classes at runtime. */
  .animated {
    animation-duration: 1s;
    animation-fill-mode: both;
  }
  .flipInX {
    backface-visibility: visible !important;
    animation-name: flipInX;
  }
  @keyframes flipInX {
    from {
      transform: perspective(400px) rotate3d(1, 0, 0, 90deg);
      animation-timing-function: ease-in;
      opacity: 0;
    }
    40% {
      transform: perspective(400px) rotate3d(1, 0, 0, -20deg);
      animation-timing-function: ease-in;
    }
    60% {
      transform: perspective(400px) rotate3d(1, 0, 0, 10deg);
      opacity: 1;
    }
    80% {
      transform: perspective(400px) rotate3d(1, 0, 0, -5deg);
    }
    to {
      transform: perspective(400px);
    }
  }
</style>
