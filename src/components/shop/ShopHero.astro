---
interface Props {
  headline?: string;
  byline?: string;
}

const {
  headline = "The Shop",
  byline = "Cedar garden beds, outdoor furniture, and landscape lighting — built to last and delivered across Greater Seattle. Add professional installation at checkout.",
} = Astro.props;
---

<section class="relative isolate overflow-x-clip bg-white px-6 py-16 sm:py-24 md:px-8">
  <div
    aria-hidden="true"
    class="absolute -top-52 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl sm:-top-80"
  >
    <div
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      class="aspect-1097/845 w-274.25 bg-linear-to-tr from-[#ff4694] to-[#776fff] opacity-15"
    >
    </div>
  </div>

  <div class="mx-auto max-w-4xl text-center">
    <h1 class="text-5xl font-semibold tracking-tight text-gray-900 sm:text-6xl">
      {headline}
    </h1>
    <p class="mt-6 text-lg font-medium text-pretty text-gray-700 sm:text-xl/8">
      {byline}
    </p>
  </div>
</section>
