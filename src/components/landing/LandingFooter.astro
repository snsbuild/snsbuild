---
import { phoneDisplay, phoneHref, email, license } from "../../siteConfig";
---

<footer class="bg-gray-900 py-12 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <h2 class="mb-3 text-lg font-bold">Saddle &amp; Spur Construction</h2>
        <p class="text-sm text-gray-400">Licensed &amp; Insured</p>
        <p class="text-sm text-gray-400">Contractor License: {license}</p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-bold uppercase">Contact</h3>
        <p>
          <a
            href={`tel:${phoneHref}`}
            data-conversion="phone"
            class="text-gray-300 transition hover:text-white"
          >
            {phoneDisplay}
          </a>
        </p>
        <p class="mt-1">
          <a
            href={`mailto:${email}`}
            class="text-gray-300 transition hover:text-white"
          >
            {email}
          </a>
        </p>
        <p class="mt-3 text-sm text-gray-400">
          Greater Seattle, King and Snohomish County
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-bold uppercase">More</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/services" class="text-gray-400 transition hover:text-white">
              All services
            </a>
          </li>
          <li>
            <a href="/portfolio" class="text-gray-400 transition hover:text-white">
              Portfolio
            </a>
          </li>
          <li>
            <a href="/about" class="text-gray-400 transition hover:text-white">
              About us
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-gray-400 transition hover:text-white">
              Privacy policy
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-gray-800 pt-8">
      <p class="text-sm text-gray-400">
        &copy; 2026 S&amp;S Construction. All rights reserved.
      </p>
    </div>
  </div>
</footer>
