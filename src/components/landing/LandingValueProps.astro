---
import Icon from "../Icon.astro";
import type { LandingPage } from "../../types/entity-types";

interface Props {
  eyebrow?: string;
  heading: string;
  byline?: string;
  items: LandingPage["valueProps"];
}

const { eyebrow = "Why us", heading, byline, items } = Astro.props;
---

<section class="bg-gray-50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-base/7 font-semibold text-indigo-600">{eyebrow}</p>
      <h2
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
      >
        {heading}
      </h2>
      {byline && <p class="mt-6 text-lg/8 text-gray-700">{byline}</p>}
    </div>

    <dl
      class="mt-16 grid grid-cols-1 gap-x-8 gap-y-12 text-base/7 text-gray-600 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        items.map((item) => (
          <div class="relative pl-10">
            <dt class="font-semibold text-gray-900">
              <Icon name={item.icon} class="absolute top-1.5 left-0 text-indigo-600" />
              {item.title}
            </dt>
            <dd class="mt-2">{item.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
