---
import { phoneDisplay, phoneHref } from "../../siteConfig";
import Horse from "../Horse.astro";
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-1">
      <a
        href="/"
        class="flex items-center transition-colors hover:text-indigo-600"
      >
        <Horse class="h-auto w-20 text-indigo-600" />
        <span
          class="-ml-3 font-header text-lg font-bold tracking-tight sm:text-2xl"
        >
          Saddle &amp; Spur Construction
        </span>
      </a>

      <div class="flex items-center gap-x-4">
        <span class="hidden text-sm text-gray-600 lg:inline">
          Licensed &amp; insured · Seattle
        </span>
        <a
          href={`tel:${phoneHref}`}
          data-conversion="phone"
          class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold whitespace-nowrap text-white shadow-xs transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        >
          <i class="fa-solid fa-phone mr-1.5" aria-hidden="true"></i>
          <span class="hidden sm:inline">{phoneDisplay}</span>
          <span class="sm:hidden">Call</span>
        </a>
      </div>
    </div>
  </div>
</header>
