---
import type { LandingPage } from "../../types/entity-types";
import { phoneDisplay, phoneHref, license } from "../../siteConfig";

interface Props {
  hero: LandingPage["hero"];
  trustBadges: string[];
  stats: LandingPage["stats"];
}

const { hero, trustBadges, stats } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-white">
  <img
    src={hero.image.src}
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 size-full object-cover opacity-10"
  />
  <div
    aria-hidden="true"
    class="absolute -top-40 left-1/2 -z-10 -translate-x-1/2 transform-gpu blur-3xl"
  >
    <div
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      class="aspect-1097/845 w-274.25 bg-linear-to-tr from-[#80caff] to-[#4f46e5] opacity-15"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-12 sm:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-x-12 gap-y-12 lg:grid-cols-2">
      {/*
        On mobile the form comes first so paid traffic lands on it with no
        scrolling, and `contents` lets the pitch fall in beneath it. On lg the
        pitch collapses back into a single left-hand column beside the form.
      */}
      <div class="contents lg:block lg:pt-6">
        <div class="order-1">
          <p class="text-base/7 font-semibold text-indigo-600">{hero.eyebrow}</p>
          <h1
            class="mt-2 text-4xl font-semibold tracking-tight text-balance text-gray-900 sm:text-5xl"
          >
            {hero.headline}
          </h1>
          <p class="mt-6 text-lg/8 text-gray-700">{hero.subhead}</p>

        </div>

        <div class="order-3 lg:mt-8">
          <ul class="space-y-3">
            {
              hero.bullets.map((bullet) => (
                <li class="flex items-start gap-3 text-base/7 text-gray-800">
                  <i class="fa-solid fa-circle-check mt-1.5 text-indigo-600" />
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href={`tel:${phoneHref}`}
              data-conversion="phone"
              class="rounded-md bg-indigo-600 px-5 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >
              <i class="fa-solid fa-phone mr-2" aria-hidden="true"></i>
              Call {phoneDisplay}
            </a>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
            {
              trustBadges.map((badge) => (
                <span class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-900/10">
                  <i class="fa-solid fa-shield-halved text-indigo-600" />
                  {badge}
                </span>
              ))
            }
          </div>
        </div>

      </div>

      <!-- Lead form -->
      <div id="lead-form" class="order-first scroll-mt-24 lg:order-none">
        <div
          class="rounded-2xl bg-white p-6 shadow-xl outline-1 -outline-offset-1 outline-black/10 sm:p-8"
        >
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">
            {hero.formHeading}
          </h2>
          <p class="mt-2 text-sm/6 text-gray-600">{hero.formByline}</p>

          <form
            name={hero.formName}
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-lead-form
            class="mt-6"
          >
            <input type="hidden" name="form-name" value={hero.formName} />
            <input type="hidden" name="landing-page" value={Astro.url.pathname} />
            <p class="hidden">
              <label>
                Don't fill this out if you're human: <input name="bot-field" />
              </label>
            </p>

            <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2">
              <div>
                <label
                  for="lp-first-name"
                  class="block text-sm/6 font-semibold text-gray-900"
                >
                  First name
                </label>
                <input
                  id="lp-first-name"
                  name="first-name"
                  type="text"
                  required
                  autocomplete="given-name"
                  class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                />
              </div>

              <div>
                <label
                  for="lp-last-name"
                  class="block text-sm/6 font-semibold text-gray-900"
                >
                  Last name
                </label>
                <input
                  id="lp-last-name"
                  name="last-name"
                  type="text"
                  autocomplete="family-name"
                  class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                />
              </div>

              <div class="sm:col-span-2">
                <label
                  for="lp-phone"
                  class="block text-sm/6 font-semibold text-gray-900"
                >
                  Phone
                </label>
                <input
                  id="lp-phone"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                />
              </div>

              <div class="sm:col-span-2">
                <label
                  for="lp-email"
                  class="block text-sm/6 font-semibold text-gray-900"
                >
                  Email
                </label>
                <input
                  id="lp-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
                />
              </div>
            </div>

            <button
              type="submit"
              class="mt-6 w-full rounded-md bg-indigo-600 px-3.5 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >
              {hero.submitLabel}
            </button>

            <p class="mt-4 text-xs/5 text-gray-500">
              No obligation and no pressure. WA contractor license {license}.
              We'll only use your details to talk about your project.
            </p>
          </form>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <dl
      class="mt-16 grid grid-cols-2 gap-x-8 gap-y-10 border-t border-gray-200 pt-10 lg:grid-cols-4"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col-reverse gap-y-2">
            <dt class="text-sm/6 text-gray-600">{stat.label}</dt>
            <dd class="text-3xl font-semibold tracking-tight text-gray-900">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
