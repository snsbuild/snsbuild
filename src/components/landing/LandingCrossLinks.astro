---
import type { LandingPage } from "../../types/entity-types";

interface Props {
  crossLinks: LandingPage["crossLinks"];
}

const { crossLinks } = Astro.props;
---

<section class="bg-gray-50 py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900">
        {crossLinks.heading}
      </h2>
      <p class="mt-3 text-base/7 text-gray-600">{crossLinks.byline}</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        crossLinks.links.map((link) => (
          <article class="group relative flex flex-col rounded-2xl bg-white p-6 shadow-sm outline-1 -outline-offset-1 outline-black/5 transition hover:shadow-md">
            <h3 class="text-base font-semibold text-gray-900">
              <a href={link.href}>
                <span aria-hidden="true" class="absolute inset-0" />
                {link.label}
              </a>
            </h3>
            <p class="mt-2 grow text-sm/6 text-gray-600">{link.description}</p>
            <span class="mt-5 text-sm font-semibold text-indigo-600 group-hover:text-indigo-500">
              Open<span aria-hidden="true"> →</span>
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>
