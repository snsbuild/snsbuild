---
type Crumb = { label: string; href?: string };

interface Props {
  crumbs: Crumb[];
  className?: string;
}

const { crumbs, className } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["text-sm", className]}>
  <ol role="list" class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      crumbs.map((crumb, i) => (
        <li class="flex items-center gap-x-2">
          {crumb.href ? (
            <a
              href={crumb.href}
              class="text-gray-500 transition hover:text-indigo-600"
            >
              {crumb.label}
            </a>
          ) : (
            <span class="font-medium text-gray-900" aria-current="page">
              {crumb.label}
            </span>
          )}
          {i < crumbs.length - 1 && (
            <span aria-hidden="true" class="text-gray-300">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
