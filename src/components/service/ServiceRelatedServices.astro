---
import type { ServiceEntity } from "../../types/entity-types";

interface Props {
  services: ServiceEntity[];
  category: string;
  className?: string;
}

const { services, category, className } = Astro.props;
---

{
  services.length > 0 && (
    <section class:list={["bg-gray-50 py-24", className]}>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="sm:flex sm:items-baseline sm:justify-between">
          <div class="max-w-3xl">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900">
              Related {category.toLowerCase()} services
            </h2>
            <p class="mt-3 text-base/7 text-gray-600">
              Homeowners planning this usually look at these too — and they're
              cheaper to build at the same time than to add later.
            </p>
          </div>

          <a
            href="/services"
            class="mt-4 hidden shrink-0 text-sm font-semibold whitespace-nowrap text-indigo-600 hover:text-indigo-500 sm:mt-0 sm:block"
          >
            All services<span aria-hidden="true"> &rarr;</span>
          </a>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm outline-1 -outline-offset-1 outline-black/5 transition hover:shadow-md">
              <img
                src={service.seo.ogImage.src}
                alt={service.seo.ogImage.alt}
                loading="lazy"
                class="aspect-3/2 w-full bg-gray-100 object-cover"
              />
              <div class="flex grow flex-col p-6">
                <h3 class="text-lg font-semibold text-gray-900">
                  <a href={service.path}>
                    <span aria-hidden="true" class="absolute inset-0" />
                    {service.name}
                  </a>
                </h3>
                <p class="mt-3 grow text-sm/6 text-gray-600">
                  {service.description}
                </p>
                <span class="mt-6 text-sm font-semibold text-indigo-600 group-hover:text-indigo-500">
                  View service<span aria-hidden="true"> &rarr;</span>
                </span>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 sm:hidden">
          <a
            href="/services"
            class="text-sm font-semibold text-indigo-600 hover:text-indigo-500"
          >
            All services<span aria-hidden="true"> &rarr;</span>
          </a>
        </div>
      </div>
    </section>
  )
}
