---
import type { PortfolioCollectionPage } from "../../types/entity-types";
import Breadcrumbs from "../Breadcrumbs.astro";
import { phoneDisplay, phoneHref } from "../../siteConfig";

interface Props {
  collection: PortfolioCollectionPage;
}

const { collection } = Astro.props;

// One case study looks stranded in a two-up grid — lay it out horizontally.
const isSolo = collection.projects.length === 1;
const {
  name,
  eyebrow,
  content,
  intro,
  stats,
  projects,
  gallery,
  relatedServices,
  closing,
  seo,
} = collection;
---

<!-- Hero -->
<section class="relative isolate overflow-hidden bg-white">
  <div class="mx-auto max-w-7xl px-6 pt-10 pb-16 sm:pb-24 lg:px-8">
    <Breadcrumbs
      className="mb-10"
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Portfolio", href: "/portfolio" },
        { label: name },
      ]}
    />

    <div class="grid grid-cols-1 gap-x-12 gap-y-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-base/7 font-semibold text-indigo-600">{eyebrow}</p>
        <h1
          class="mt-2 text-4xl font-semibold tracking-tight text-balance text-gray-900 sm:text-5xl"
        >
          {content.headline}
        </h1>
        <p class="mt-6 text-xl/8 text-gray-700">{content.byline}</p>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={content.primaryCta.href}
            class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs transition hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            {content.primaryCta.label}
          </a>
          <a
            href={`tel:${phoneHref}`}
            class="text-sm/6 font-semibold text-gray-900 hover:text-indigo-700"
          >
            Or call {phoneDisplay} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div>
        <img
          src={seo.ogImage.src}
          alt={seo.ogImage.alt}
          class="aspect-3/2 w-full rounded-2xl bg-gray-100 object-cover shadow-xl outline-1 -outline-offset-1 outline-black/10"
          width="1600"
          height="1067"
        />
      </div>
    </div>

    <!-- Stats -->
    <dl
      class="mt-16 grid grid-cols-2 gap-x-8 gap-y-10 border-t border-gray-200 pt-10 lg:grid-cols-4"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col-reverse gap-y-2">
            <dt class="text-sm/6 text-gray-600">{stat.label}</dt>
            <dd class="text-3xl font-semibold tracking-tight text-gray-900">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- Intro -->
<section class="bg-white pb-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      {intro.map((p) => <p class="mt-6 text-lg/8 text-gray-700">{p}</p>)}
    </div>
  </div>
</section>

<!-- Case studies -->
<section class="bg-gray-50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-base/7 font-semibold text-indigo-600">Case studies</h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900"
      >
        The full story behind the photos
      </p>
    </div>

    <div
      class:list={[
        "mt-14 grid grid-cols-1 gap-10",
        !isSolo && "lg:grid-cols-2",
      ]}
    >
      {
        projects.map((project) => (
          <article
            class:list={[
              "flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm outline-1 -outline-offset-1 outline-black/5",
              isSolo && "lg:flex-row",
            ]}
          >
            <a
              href={project.path}
              class:list={["group block", isSolo && "lg:w-1/2 lg:shrink-0"]}
            >
              <img
                src={project.seo.ogImage.src}
                alt={project.seo.ogImage.alt}
                loading="lazy"
                class:list={[
                  "aspect-3/2 w-full bg-gray-100 object-cover transition group-hover:opacity-90",
                  isSolo && "lg:h-full",
                ]}
              />
            </a>

            <div class="flex grow flex-col p-8 lg:justify-center">
              <div class="flex items-center gap-x-3 text-xs">
                <span class="rounded-full bg-indigo-50 px-3 py-1.5 font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/10">
                  {project.project.serviceName}
                </span>
                <span class="text-gray-500">
                  {project.project.location.neighborhood} ·{" "}
                  {project.project.duration}
                </span>
              </div>

              <h3 class="mt-4 text-2xl font-semibold tracking-tight text-gray-900">
                <a href={project.path} class="hover:text-indigo-700">
                  {project.name}
                </a>
              </h3>

              <p class="mt-3 text-base/7 text-gray-600">
                {project.description}
              </p>

              <ul class="mt-6 space-y-2 text-sm/6 text-gray-600">
                {project.highlights.slice(0, isSolo ? 6 : 4).map((h) => (
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-circle-check mt-1.5 text-xs text-indigo-600" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <a
                href={project.path}
                class="mt-8 text-sm font-semibold text-indigo-600 hover:text-indigo-500"
              >
                Read the full case study<span aria-hidden="true"> →</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2
        class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl"
      >
        {gallery.heading}
      </h2>
      <p class="mt-4 text-lg/8 text-gray-600">{gallery.byline}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.images.map((image) => (
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="aspect-3/2 w-full rounded-2xl bg-gray-100 object-cover shadow-sm outline-1 -outline-offset-1 outline-black/10"
          />
        ))
      }
    </div>
  </div>
</section>

<!-- Related services -->
<section class="bg-gray-50 py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-gray-900">
      Services behind this work
    </h2>
    <p class="mt-3 text-base/7 text-gray-600">
      Read what's involved, what it costs to get wrong, and how we scope it.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        relatedServices.map((service) => (
          <article class="group relative flex flex-col rounded-2xl bg-white p-6 shadow-sm outline-1 -outline-offset-1 outline-black/5 transition hover:shadow-md">
            <h3 class="text-lg font-semibold text-gray-900">
              <a href={service.path}>
                <span aria-hidden="true" class="absolute inset-0" />
                {service.name}
              </a>
            </h3>
            <p class="mt-3 grow text-sm/6 text-gray-600">
              {service.description}
            </p>
            <span class="mt-6 text-sm font-semibold text-indigo-600 group-hover:text-indigo-500">
              View service<span aria-hidden="true"> →</span>
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Closing CTA -->
<section class="bg-linear-to-r from-indigo-700 to-indigo-900 py-20 text-white">
  <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
    <h2 class="text-4xl font-bold tracking-tight sm:text-5xl">
      {closing.heading}
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-indigo-100">{closing.body}</p>
    <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
      <a
        href={closing.primaryCta.href}
        class="rounded bg-white px-6 py-3 font-bold text-indigo-700 transition hover:bg-gray-100"
      >
        {closing.primaryCta.label}
      </a>
      <a
        href={closing.secondaryCta.href}
        class="rounded border-2 border-white px-6 py-3 font-bold text-white transition hover:bg-white hover:text-indigo-700"
      >
        {closing.secondaryCta.label}
      </a>
    </div>
  </div>
</section>
