---
import Icon from "../Icon.astro";
---

<section id="services-text">
  <div class="bg-white pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p class="text-base/7 font-semibold text-indigo-600">Our Services</p>
        <h2
          class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
        >
          Quality craftsmanship for every project.
        </h2>
        <p class="mt-6 text-lg/8 text-gray-700">
          From kitchen and bathroom remodels to custom decks and complete home
          renovations, we bring expertise, attention to detail, and reliable
          service to every project we undertake in the Seattle area.
        </p>
      </div>
      <dl
        class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 text-base/7 text-gray-600 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-16"
      >
        <div class="relative pl-9">
          <dt class="inline font-semibold text-gray-900">
            <Icon name="kitchen-set" class="absolute top-1 left-1 text-indigo-600" />
            Kitchen Remodeling.
          </dt>
          <dd class="inline">
            Modern, functional kitchens that become the heart of your home. From
            new cabinets and countertops to layout optimization and appliance
            installation.
          </dd>
        </div>
        <div class="relative pl-9">
          <dt class="inline font-semibold text-gray-900">
            <Icon name="bath" class="absolute top-1 left-1 text-indigo-600" />
            Bathroom Remodeling.
          </dt>
          <dd class="inline">
            Spa-like bathrooms designed for comfort and durability. Complete
            renovations including tiles, fixtures, lighting, and efficient use
            of space.
          </dd>
        </div>
        <div class="relative pl-9">
          <dt class="inline font-semibold text-gray-900">
            <Icon name="person-digging" class="absolute top-1 left-1 text-indigo-600" />
            <a
              href="/services/deck-building-seattle/"
              class="hover:text-indigo-700">Decks &amp; Outdoor Structures.</a
            >
          </dt>
          <dd class="inline">
            Beautiful outdoor spaces that extend your home's living area. <a
              href="/services/deck-building-seattle/"
              class="text-indigo-700 hover:underline">Custom decks</a
            >, patios, <a
              href="/services/shed-building-seattle/"
              class="text-indigo-700 hover:underline">sheds and backyard offices</a
            >, and exterior refinishing with weather-resistant materials.
          </dd>
        </div>
        <div class="relative pl-9">
          <dt class="inline font-semibold text-gray-900">
            <Icon name="house-chimney-user" class="absolute top-1 left-1 text-indigo-600" />
            Home Renovations.
          </dt>
          <dd class="inline">
            Complete home transformations that maximize value and enhance living
            spaces. Large-scale projects handled with comprehensive planning and
            expert execution.
          </dd>
        </div>
        <div class="relative pl-9">
          <dt class="inline font-semibold text-gray-900">
            <Icon name="compass-drafting" class="absolute top-1 left-1 text-indigo-600" />
            Expert Contractors.
          </dt>
          <dd class="inline">
            Experienced professionals dedicated to quality workmanship. Our team
            brings proven expertise, reliability, and attention to detail to
            every project.
          </dd>
        </div>
        <div class="relative pl-9">
          <dt class="inline font-semibold text-gray-900">
            <Icon name="magnifying-glass-dollar" class="absolute top-1 left-1 text-indigo-600" /> Transparent Pricing.
          </dt>
          <dd class="inline">
            Fair, honest pricing without hidden surprises. We provide detailed
            estimates upfront so you know exactly what to expect.
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
