---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const popularServices = [
  { label: "Deck building", href: "/services/deck-building-seattle" },
  { label: "Sheds & backyard offices", href: "/services/shed-building-seattle" },
  { label: "Outdoor living", href: "/services/outdoor-seattle" },
  { label: "Kitchen remodeling", href: "/services/kitchen-remodeling-seattle" },
  { label: "Bathroom remodeling", href: "/services/bathroom-remodeling-seattle" },
  { label: "ADU construction", href: "/services/adu-construction-seattle" },
];

import { phoneDisplay, phoneHref, license } from "../siteConfig";
import Horse from "./Horse.astro";
---

<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 mb-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="text-lg font-bold mb-4">S&S Construction</h3>
        <p class="text-gray-400">Licensed & Insured</p>
        <p class="text-gray-400">Contractor License: {license}</p>
        <p class="text-gray-400 mt-4">
          <a href={`tel:${phoneHref}`} class="hover:text-indigo-400 transition">
            {phoneDisplay}
          </a>
        </p>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase mb-4">Navigation</h4>
        <ul class="space-y-2">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-gray-400 hover:text-white transition"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/privacy"
              class="text-gray-400 hover:text-white transition"
            >
              Privacy Policy
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase mb-4">Popular Services</h4>
        <ul class="space-y-2">
          {
            popularServices.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-gray-400 hover:text-white transition"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase mb-4">Service Area</h4>
        <p class="text-gray-400 text-sm">
          Greater Seattle, King and Snohomish County
        </p>
        <Horse class="w-30 h-auto" />
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8">
      <p class="text-gray-400 text-sm">
        &copy; 2026 S&S Construction. All rights reserved.
      </p>
    </div>
  </div>
</footer>
