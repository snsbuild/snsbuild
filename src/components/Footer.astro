---
import {
  phoneDisplay,
  phoneHref,
  email,
  license,
  hours,
  businessProfiles,
} from "../siteConfig";
import { services } from "../data";
import Horse from "./Horse.astro";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: "Portfolio", href: "/portfolio/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

// Every service page gets a sitewide link from here, built from the service
// data so a new service is linked the moment it is added.
const serviceLinks = services.map((s) => ({ label: s.name, href: s.path }));

// First profile in siteConfig is the Google Business Profile.
const googleProfile = businessProfiles[0];
---

<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 mb-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="text-lg font-bold mb-4">Saddle & Spur Construction</h3>
        <p class="text-gray-400">Licensed & Insured</p>
        <p class="text-gray-400">Contractor License: {license}</p>
        {/* Name, city, phone and email together, matching the Google
            Business Profile. */}
        <p class="text-gray-400 mt-4">Seattle, WA</p>
        <p class="text-gray-400">
          <a href={`tel:${phoneHref}`} class="hover:text-indigo-400 transition">
            {phoneDisplay}
          </a>
        </p>
        <p class="text-gray-400">
          <a href={`mailto:${email}`} class="hover:text-indigo-400 transition">
            {email}
          </a>
        </p>
        <p class="text-gray-400 mt-4">{hours.display}</p>
        {
          googleProfile && (
            <p class="text-gray-400">
              <a
                href={googleProfile}
                rel="noopener"
                class="hover:text-indigo-400 transition"
              >
                Find us on Google Maps
              </a>
            </p>
          )
        }
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase mb-4">Navigation</h4>
        <ul class="space-y-2">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-gray-400 hover:text-white transition"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/privacy/"
              class="text-gray-400 hover:text-white transition"
            >
              Privacy Policy
            </a>
          </li>
        </ul>
      </div>

      <div class="sm:col-span-2">
        <h4 class="text-sm font-bold uppercase mb-4">Services</h4>
        <ul class="gap-x-8 sm:columns-2">
          {
            serviceLinks.map((item) => (
              <li class="mb-2 break-inside-avoid">
                <a
                  href={item.href}
                  class="text-gray-400 hover:text-white transition"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-t border-gray-800 pt-8 flex items-end justify-between gap-6"
    >
      <div>
        <p class="text-gray-400 text-sm">
          Serving Greater Seattle, King and Snohomish County
        </p>
        <p class="text-gray-400 text-sm mt-1">
          &copy; 2026 Saddle & Spur Construction. All rights reserved.
        </p>
      </div>
      <Horse class="w-30 h-auto shrink-0" />
    </div>
  </div>
</footer>
