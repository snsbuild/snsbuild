---
import { email, license, phoneDisplay, phoneHref } from "../siteConfig";

const { className } = Astro.props;
---

<div class:list={["relative", "isolate", className]}>
  <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2">
    <div class="relative px-6 pt-12 lg:static lg:px-8 lg:pt-32">
      <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
        <div
          class="absolute inset-y-0 left-0 -z-10 w-full overflow-hidden bg-white ring-gray-900/10 lg:w-1/2"
        >
          <svg
            aria-hidden="true"
            class="absolute inset-0 size-full mask-[radial-gradient(100%_100%_at_top_right,white,transparent)] stroke-gray-200"
          >
            <defs>
              <pattern
                id="83fd4e5a-9d52-42fc-97b6-718e5d7ee527"
                width="200"
                height="200"
                x="100%"
                y="-1"
                patternUnits="userSpaceOnUse"
              >
                <path d="M130 200V.5M.5 .5H200" fill="none"></path>
              </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" class="fill-white"
            ></rect>
            <svg x="100%" y="-1" class="overflow-visible fill-gray-50">
              <path d="M-470.5 0h201v201h-201Z" stroke-width="0"></path>
            </svg>
            <rect
              width="100%"
              height="100%"
              fill="url(#83fd4e5a-9d52-42fc-97b6-718e5d7ee527)"
              stroke-width="0"></rect>
          </svg>
          <div
            aria-hidden="true"
            class="absolute top-[calc(100%-13rem)] -left-56 hidden transform-gpu blur-3xl lg:top-[calc(50%-7rem)] lg:left-[max(-14rem,calc(100%-59rem))]"
          >
            <div
              style="clip-path: polygon(74.1% 56.1%, 100% 38.6%, 97.5% 73.3%, 85.5% 100%, 80.7% 98.2%, 72.5% 67.7%, 60.2% 37.8%, 52.4% 32.2%, 47.5% 41.9%, 45.2% 65.8%, 27.5% 23.5%, 0.1% 35.4%, 17.9% 0.1%, 27.6% 23.5%, 76.1% 2.6%, 74.1% 56.1%)"
              class="aspect-1155/678 w-288.75 bg-linear-to-br from-[#80caff] to-[#4f46e5] opacity-10"
            >
            </div>
          </div>
        </div>
        <h2
          class="hidden text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl lg:block"
        >
          Get a Free Estimate
        </h2>
        <p class="text-lg/8 text-gray-600 lg:mt-6">
          Thinking about remodeling? Let's talk it through. Leave your name and
          how to reach you, and we'll call to hear about your project, schedule
          a consultation, and walk you through next steps.
        </p>
        <p class="mt-6 text-lg/8 text-gray-600">
          We work with homeowners across Seattle and aim to make the process
          clear, organized, and stress-free from day one.
        </p>
        <div>
          <div class="space-y-6 pt-6">
            <div>
              <h3 class="font-bold text-lg mb-2">Phone</h3>
              <a
                href={`tel:${phoneHref}`}
                class="text-indigo-700 hover:text-indigo-900 text-lg"
              >
                {phoneDisplay}
              </a>
              <p class="text-gray-600 text-sm mt-1">
                Available Monday-Friday, 8am-6pm
              </p>
            </div>

            <div>
              <h3 class="font-bold text-lg mb-2">Email</h3>
              <a
                href={`mailto:${email}`}
                class="text-indigo-700 hover:text-indigo-900"
              >
                {email}
              </a>
            </div>
          </div>

          <div class="mt-8 p-6 bg-indigo-100 rounded-lg">
            <p class="text-sm text-gray-700">
              <>
                <strong>Licensed & Insured</strong>
                <br />
              </>
              WA Contractor License <strong>{license}</strong>
              <br />
              Full general liability & workers compensation coverage
            </p>
          </div>
        </div>
      </div>
    </div>
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-lead-form
      class="order-first px-6 pt-10 lg:order-none lg:pt-20"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>
      <div class="mx-auto max-w-xl lg:mr-0 lg:max-w-lg">
        <h2
          class="mb-6 text-3xl font-semibold tracking-tight text-pretty text-gray-900 lg:hidden"
        >
          Get a Free Estimate
        </h2>
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
          <!-- First Name -->
          <div>
            <label
              for="first-name"
              class="block text-sm/6 font-semibold text-gray-900"
              >First name</label
            >
            <div class="mt-2.5">
              <input
                id="first-name"
                type="text"
                name="first-name"
                required
                autocomplete="given-name"
                class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
              />
            </div>
          </div>
          <!-- Last Name -->
          <div>
            <label
              for="last-name"
              class="block text-sm/6 font-semibold text-gray-900"
              >Last name</label
            >
            <div class="mt-2.5">
              <input
                id="last-name"
                type="text"
                name="last-name"
                autocomplete="family-name"
                class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
              />
            </div>
          </div>
          <!-- Phone -->
          <div class="sm:col-span-2">
            <label
              for="phone-number"
              class="block text-sm/6 font-semibold text-gray-900"
              >Phone number</label
            >
            <div class="mt-2.5">
              <input
                id="phone-number"
                type="tel"
                name="phone-number"
                required
                autocomplete="tel"
                class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
              />
            </div>
          </div>
          <!-- Email -->
          <div class="sm:col-span-2">
            <label
              for="email"
              class="block text-sm/6 font-semibold text-gray-900">Email</label
            >
            <div class="mt-2.5">
              <input
                id="email"
                type="email"
                name="email"
                required
                autocomplete="email"
                class="block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
              />
            </div>
          </div>
        </div>
        <!-- Submit -->
        <div class="mt-8 flex justify-end">
          <button
            type="submit"
            class="w-full rounded-md sm:w-auto bg-indigo-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >Get My Free Estimate</button
          >
        </div>
      </div>
    </form>
  </div>
</div>
