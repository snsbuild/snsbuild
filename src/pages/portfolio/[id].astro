---
import Layout from "../../layouts/Layout.astro";
import PortfolioHero from "../../components/portfolio/PortfolioHero.astro";
import PortfolioStory from "../../components/portfolio/PortfolioStory.astro";
import PortfolioServicesPerformed from "../../components/portfolio/PortfolioServicesPerformed.astro";
import PortfolioTestimonial from "../../components/portfolio/PortfolioTestimonial.astro";
import PortfolioRelatedProjects from "../../components/portfolio/PortfolioRelatedProjects.astro";
import CallToAction from "../../components/CallToAction.astro";
import PortfolioOverview from "../../components/portfolio/PortfolioOverview.astro";
import { buildSeoFrom } from "../../seo";
import { portfolio } from "../../data";
import { portfolioCollections } from "../../data/portfolio-collections";
import PortfolioGallery from "../../components/portfolio/PortfolioGallery.astro";

export async function getStaticPaths() {
  return portfolio.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const page = portfolio.find((p) => p.id === id)!;
const seo = buildSeoFrom(page);

// If this project belongs to a curated collection, send "see more" traffic
// there rather than to the unfiltered portfolio index.
const collection = portfolioCollections.find((c) =>
  c.projects.some((p) => p.id === page.id),
);

const {
  name,
  description,
  hero,
  overview,
  highlights,
  story,
  gallery,
  testimonial,
  related,
  servicesPerformed,
} = page;
---

<Layout {...seo}>
  <PortfolioHero hero={hero} name={name} description={description} />
  <PortfolioOverview
    highlights={highlights}
    overview={overview}
    className="py-32"
  />
  <PortfolioTestimonial testimonial={testimonial} />

  <PortfolioStory story={story} />
  <PortfolioGallery images={gallery.images} />
  <CallToAction
    ctaTwo={collection ? `See more ${collection.name.toLowerCase()}` : "See other case studies"}
    ctaTwoHref={collection?.path ?? "/portfolio"}
  />
  <PortfolioServicesPerformed
    eyebrow="What we did"
    title="Services performed on this job"
    intro={servicesPerformed.intro}
    items={servicesPerformed.items}
  />

  <!-- <Faq faqs={related.faqs} /> -->
  <PortfolioRelatedProjects related={related!} />
</Layout>
